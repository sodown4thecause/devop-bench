{
  "name": "pinboard-fixture",
  "version": "0.1.0",
  "private": true,
  "description": "Pinboard: a tiny feedback board used as the DevOp Bench fixture. Contains PLANTED bugs on purpose.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:planted": "node scripts/check-planted.mjs",
    "db:migrate": "node scripts/migrate.mjs"
  },
  "dependencies": {
    "next": "15.5.28",
    "pg": "8.16.3",
    "react": "19.2.9",
    "react-dom": "19.2.9"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.18.6",
    "@types/pg": "8.15.5",
    "@types/react": "19.3.0",
    "eslint": "9.39.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.1",
    "vitest": "3.2.4"
  },
  "engines": { "node": ">=20" }
}
